<Window x:Class="YouTube4KDownloader.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="4K Video Downloader" Height="850" Width="1080" MinHeight="720" MinWidth="920" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,7"/></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style>
 </Window.Resources>
 <Grid x:Name="RootGrid" Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock x:Name="AppTitleText" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="CopyrightNoticeText" Foreground="DarkRed"/></StackPanel>
   <TextBlock Grid.Column="1" x:Name="LanguageLabel" VerticalAlignment="Center" Margin="10"/>
   <ComboBox Grid.Column="2" x:Name="LanguageComboBox" SelectionChanged="LanguageComboBox_SelectionChanged"><ComboBoxItem Content="한국어" Tag="ko"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
  </Grid>
  <TabControl Grid.Row="1">
   <TabItem x:Name="DownloadTab"><Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="VideoUrlLabel" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="UrlTextBox"/><Button Grid.Column="2" x:Name="PasteButton" Click="Paste_Click"/><Button Grid.Column="3" x:Name="AddQueueButton" Click="AddQueue_Click"/><Button Grid.Column="4" x:Name="InspectButton" Click="Inspect_Click"/>
    </Grid>
    <Border Grid.Row="1" x:Name="InfoBorder" Background="#F3F3F3" CornerRadius="6" Padding="10" Margin="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="ThumbnailImage" Width="140" Height="80"/><StackPanel Grid.Column="1" Margin="12,0"><TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/><TextBlock x:Name="MetaText" Margin="0,6"/></StackPanel></Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="185"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="SaveFolderLabel"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputFolderTextBox"/><Button Grid.Column="1" x:Name="BrowseFolderButton" Click="BrowseFolder_Click"/></Grid></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock x:Name="QualityLabel"/><ComboBox x:Name="QualityComboBox" SelectedIndex="0"><ComboBoxItem x:Name="Best4KItem" Tag="2160"/><ComboBoxItem x:Name="Quality4KItem" Tag="2160"/><ComboBoxItem x:Name="QualityQHDItem" Tag="1440"/><ComboBoxItem x:Name="QualityFHDItem" Tag="1080"/><ComboBoxItem x:Name="QualityHDItem" Tag="720"/><ComboBoxItem x:Name="QualitySDItem" Tag="480"/></ComboBox></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock x:Name="OutputFormatLabel"/><ComboBox x:Name="FormatComboBox" SelectedIndex="0"><ComboBoxItem Content="MP4" Tag="mp4"/><ComboBoxItem Content="MKV" Tag="mkv"/><ComboBoxItem Content="MP3" Tag="mp3"/><ComboBoxItem Content="M4A" Tag="m4a"/></ComboBox></StackPanel>
    </Grid>
    <WrapPanel Grid.Row="3"><CheckBox x:Name="PlaylistCheckBox" Margin="6"/><CheckBox x:Name="SubtitleCheckBox" Margin="6"/><CheckBox x:Name="AutoSubtitleCheckBox" Margin="6"/><CheckBox x:Name="ThumbnailCheckBox" Margin="6"/><CheckBox x:Name="EmbedMetadataCheckBox" IsChecked="True" Margin="6"/><CheckBox x:Name="OpenAfterCheckBox" Margin="6"/></WrapPanel>
    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="FileNameLabel" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="FileNameTemplateTextBox"/><TextBlock Grid.Column="2" x:Name="BrowserCookiesLabel" VerticalAlignment="Center" Margin="8"/><ComboBox Grid.Column="3" x:Name="BrowserCookiesComboBox" SelectedIndex="0"><ComboBoxItem Content="None" Tag="none"/><ComboBoxItem Content="Chrome" Tag="chrome"/><ComboBoxItem Content="Edge" Tag="edge"/><ComboBoxItem Content="Firefox" Tag="firefox"/><ComboBoxItem Content="Brave" Tag="brave"/></ComboBox><Button Grid.Column="4" x:Name="CookiesFileButton" Click="BrowseCookies_Click"/><TextBox Grid.Column="5" x:Name="CookiesTextBox" IsReadOnly="True"/>
    </Grid>
    <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <GroupBox x:Name="QueueGroup" Margin="4"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="QueueGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn x:Name="QueueTitleColumn" Binding="{Binding Title}" Width="*"/><DataGridTextColumn x:Name="QueueStatusColumn" Binding="{Binding Status}" Width="120"/><DataGridTextColumn x:Name="QueueProgressColumn" Binding="{Binding Progress, StringFormat={}{0:0}%}" Width="80"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal"><Button x:Name="StartQueueButton" Click="StartQueue_Click"/><Button x:Name="RemoveQueueButton" Click="RemoveQueue_Click"/><Button x:Name="ClearQueueButton" Click="ClearQueue_Click"/><Button x:Name="CancelButton" Click="Cancel_Click" IsEnabled="False"/></StackPanel></Grid></GroupBox>
     <GroupBox Grid.Column="1" x:Name="LogGroup" Margin="4"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ProgressBar x:Name="DownloadProgressBar" Height="22"/><TextBlock Grid.Row="1" x:Name="StatusText" Margin="4"/><TextBox Grid.Row="2" x:Name="LogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Malgun Gothic" TextWrapping="NoWrap"/></Grid></GroupBox>
    </Grid>
   </Grid></TabItem>
   <TabItem x:Name="HistoryTab"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn x:Name="HistoryDateColumn" Binding="{Binding DownloadedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/><DataGridTextColumn x:Name="HistoryTitleColumn" Binding="{Binding Title}" Width="*"/><DataGridTextColumn x:Name="HistoryFormatColumn" Binding="{Binding Format}" Width="80"/><DataGridCheckBoxColumn x:Name="HistorySuccessColumn" Binding="{Binding Success}" Width="80"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal"><Button x:Name="RedownloadButton" Click="Redownload_Click"/><Button x:Name="OpenHistoryFolderButton" Click="OpenHistoryFolder_Click"/><Button x:Name="ClearHistoryButton" Click="ClearHistory_Click"/></StackPanel></Grid></TabItem>
  </TabControl>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OpenFolderButton" Click="OpenFolder_Click"/><Button x:Name="UpdateToolsButton" Click="UpdateTools_Click"/><Button x:Name="ClearLogButton" Click="ClearLog_Click"/></StackPanel>
 </Grid>
</Window>