<Window x:Class="YouTube4KDownloader.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="YouTube 4K Downloader" Height="900" Width="1180" MinHeight="760" MinWidth="980"
 WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Segoe UI" Icon="Assets/AppIcon.ico">
 <Window.Resources>
  <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2D55"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#E62249"/>
  <SolidColorBrush x:Key="TextBrush" Color="#172033"/>
  <SolidColorBrush x:Key="MutedTextBrush" Color="#667085"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#E3E8EF"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>

  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Margin" Value="4"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="MinHeight" Value="36"/>
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#F7F8FA"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="10,8"/>
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Margin" Value="7,5"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style TargetType="GroupBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="5"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5"/>
   <Setter Property="RowBackground" Value="#FFFFFF"/><Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
   <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/>
   <Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionUnit" Value="FullRow"/>
  </Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem">
   <Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabBorder" Background="Transparent" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CardStyle" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="4"/>
   <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06"/></Setter.Value></Setter>
  </Style>
 </Window.Resources>

 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18,14" Margin="4,4,4,14">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal">
      <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
       <TextBlock Text="▶" Foreground="White" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
       <TextBlock x:Name="AppTitleText" FontSize="24" FontWeight="Bold"/>
       <TextBlock Text="Fast, simple and multilingual video downloads" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
      </StackPanel>
     </StackPanel>
     <TextBlock x:Name="CopyrightNoticeText" Foreground="#C62828" Margin="54,5,0,0" FontSize="11"/>
    </StackPanel>
    <TextBlock Grid.Column="1" x:Name="LanguageLabel" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="{StaticResource MutedTextBrush}"/>
    <ComboBox Grid.Column="2" x:Name="LanguageComboBox" SelectionChanged="LanguageComboBox_SelectionChanged">
     <ComboBoxItem Content="자동 / Automatic" Tag="auto"/><ComboBoxItem Content="한국어" Tag="ko"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="日本語" Tag="ja"/><ComboBoxItem Content="简体中文" Tag="zh-Hans"/><ComboBoxItem Content="繁體中文" Tag="zh-Hant"/><ComboBoxItem Content="Español" Tag="es"/><ComboBoxItem Content="Deutsch" Tag="de"/><ComboBoxItem Content="Français" Tag="fr"/><ComboBoxItem Content="Português" Tag="pt"/><ComboBoxItem Content="Русский" Tag="ru"/><ComboBoxItem Content="Italiano" Tag="it"/><ComboBoxItem Content="Nederlands" Tag="nl"/><ComboBoxItem Content="Polski" Tag="pl"/><ComboBoxItem Content="Türkçe" Tag="tr"/><ComboBoxItem Content="Українська" Tag="uk"/><ComboBoxItem Content="Tiếng Việt" Tag="vi"/><ComboBoxItem Content="Bahasa Indonesia" Tag="id"/><ComboBoxItem Content="ไทย" Tag="th"/><ComboBoxItem Content="العربية" Tag="ar"/><ComboBoxItem Content="हिन्दी" Tag="hi"/>
    </ComboBox>
   </Grid>
  </Border>

  <TabControl Grid.Row="1">
   <TabItem x:Name="DownloadTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid Margin="4,10,4,4">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="420"/></Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock x:Name="VideoUrlLabel" FontSize="14" FontWeight="SemiBold" Margin="4,0,4,6"/>
         <TextBox x:Name="UrlTextBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" ToolTip="여러 링크를 줄바꿈 또는 공백으로 구분해 입력할 수 있습니다."/>
        </StackPanel>
        <StackPanel Grid.Column="1" Width="190" Margin="12,18,0,0">
         <Button x:Name="AddQueueButton" Click="AddQueue_Click" Style="{StaticResource PrimaryButtonStyle}"/>
         <UniformGrid Columns="2"><Button x:Name="PasteButton" Click="Paste_Click"/><Button x:Name="InspectButton" Click="Inspect_Click"/></UniformGrid>
        </StackPanel>
        <Border Grid.ColumnSpan="2" Margin="4,116,4,0" Background="#FFF8FA" BorderBrush="#FFD4DE" BorderThickness="1" CornerRadius="8" Padding="8">
         <WrapPanel>
          <CheckBox x:Name="AutoClipboardCheckBox" Checked="AutomationOption_Changed" Unchecked="AutomationOption_Changed"/>
          <CheckBox x:Name="AutoQueueCheckBox" Checked="AutomationOption_Changed" Unchecked="AutomationOption_Changed"/>
          <CheckBox x:Name="AutoStartCheckBox" Checked="AutomationOption_Changed" Unchecked="AutomationOption_Changed"/>
         </WrapPanel>
        </Border>
       </Grid>
      </Border>

      <Border Grid.Row="1" x:Name="InfoBorder" Style="{StaticResource CardStyle}" Padding="12">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="140" Height="80" CornerRadius="8" Background="#EEF1F5" ClipToBounds="True"><Image x:Name="ThumbnailImage" Stretch="UniformToFill"/></Border>
        <StackPanel Grid.Column="1" Margin="14,4,4,4"><TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/><TextBlock x:Name="MetaText" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}"/></StackPanel>
       </Grid>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource CardStyle}">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="SaveFolderLabel" FontWeight="SemiBold" Margin="4,0,4,4"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputFolderTextBox"/><Button Grid.Column="1" x:Name="BrowseFolderButton" Click="BrowseFolder_Click"/></Grid></StackPanel>
        <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock x:Name="QualityLabel" FontWeight="SemiBold" Margin="4,0,4,4"/><ComboBox x:Name="QualityComboBox" SelectedIndex="0"><ComboBoxItem x:Name="Best4KItem" Tag="2160"/><ComboBoxItem x:Name="Quality4KItem" Tag="2160"/><ComboBoxItem x:Name="QualityQHDItem" Tag="1440"/><ComboBoxItem x:Name="QualityFHDItem" Tag="1080"/><ComboBoxItem x:Name="QualityHDItem" Tag="720"/><ComboBoxItem x:Name="QualitySDItem" Tag="480"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="2" Margin="10,0,0,0"><TextBlock x:Name="OutputFormatLabel" FontWeight="SemiBold" Margin="4,0,4,4"/><ComboBox x:Name="FormatComboBox" SelectedIndex="0"><ComboBoxItem x:Name="StandardMp4Item" Content="MP4" Tag="mp4"/><ComboBoxItem x:Name="PremiereMp4Item" Content="MP4 (Premiere Pro)" Tag="mp4_premiere"/><ComboBoxItem Content="MP3" Tag="mp3"/><ComboBoxItem Content="M4A" Tag="m4a"/></ComboBox></StackPanel>
       </Grid>
      </Border>

      <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="10"><WrapPanel><CheckBox x:Name="PlaylistCheckBox"/><CheckBox x:Name="SubtitleCheckBox"/><CheckBox x:Name="AutoSubtitleCheckBox"/><CheckBox x:Name="ThumbnailCheckBox"/><CheckBox x:Name="EmbedMetadataCheckBox" IsChecked="True"/><CheckBox x:Name="OpenAfterCheckBox"/></WrapPanel></Border>

      <Border Grid.Row="4" Style="{StaticResource CardStyle}">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="FileNameLabel" VerticalAlignment="Center" Margin="4"/><TextBox Grid.Column="1" x:Name="FileNameTemplateTextBox"/>
        <TextBlock Grid.Column="2" x:Name="BrowserCookiesLabel" VerticalAlignment="Center" Margin="12,4,4,4"/>
        <ComboBox Grid.Column="3" x:Name="BrowserCookiesComboBox" SelectedIndex="0"><ComboBoxItem Content="None" Tag="none"/><ComboBoxItem Content="Firefox" Tag="firefox"/><ComboBoxItem Content="Brave" Tag="brave"/></ComboBox>
        <Button Grid.Column="4" x:Name="CookiesFileButton" Click="BrowseCookies_Click"/><TextBox Grid.Column="5" x:Name="CookiesTextBox" IsReadOnly="True"/>
       </Grid>
      </Border>

      <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource CardStyle}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="QueueGroup" FontWeight="SemiBold" FontSize="14" Margin="5,2,5,10"/>
        <DataGrid Grid.Row="1" x:Name="QueueGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn x:Name="QueueTitleColumn" Binding="{Binding Title}" Width="*"/><DataGridTextColumn x:Name="QueueStatusColumn" Binding="{Binding Status}" Width="120"/><DataGridTextColumn x:Name="QueueProgressColumn" Binding="{Binding Progress, StringFormat={}{0:0}%}" Width="80"/></DataGrid.Columns></DataGrid>
        <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button x:Name="StartQueueButton" Click="StartQueue_Click" Style="{StaticResource PrimaryButtonStyle}"/><Button x:Name="RemoveQueueButton" Click="RemoveQueue_Click"/><Button x:Name="ClearQueueButton" Click="ClearQueue_Click"/><Button x:Name="CancelButton" Click="Cancel_Click" IsEnabled="False"/></WrapPanel>
       </Grid></Border>
       <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="LogGroup" FontWeight="SemiBold" FontSize="14" Margin="5,2,5,10"/>
        <ProgressBar Grid.Row="1" x:Name="DownloadProgressBar" Height="10" Margin="4" Foreground="{StaticResource PrimaryBrush}" Background="#EEF1F5"/>
        <TextBlock Grid.Row="2" x:Name="StatusText" Margin="6,6,6,8" Foreground="{StaticResource MutedTextBrush}"/>
        <TextBox Grid.Row="3" x:Name="LogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" Background="#101828" Foreground="#D0D5DD" BorderThickness="0"/>
       </Grid></Border>
      </Grid>
     </Grid>
    </ScrollViewer>
   </TabItem>

   <TabItem x:Name="HistoryTab">
    <Border Style="{StaticResource CardStyle}" Margin="4,10,4,4"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn x:Name="HistoryDateColumn" Binding="{Binding DownloadedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/><DataGridTextColumn x:Name="HistoryTitleColumn" Binding="{Binding Title}" Width="*"/><DataGridTextColumn x:Name="HistoryFormatColumn" Binding="{Binding Format}" Width="80"/><DataGridCheckBoxColumn x:Name="HistorySuccessColumn" Binding="{Binding Success}" Width="80"/></DataGrid.Columns></DataGrid>
     <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button x:Name="RedownloadButton" Click="Redownload_Click" Style="{StaticResource PrimaryButtonStyle}"/><Button x:Name="OpenHistoryFolderButton" Click="OpenHistoryFolder_Click"/><Button x:Name="ClearHistoryButton" Click="ClearHistory_Click"/></WrapPanel>
    </Grid></Border>
   </TabItem>
  </TabControl>

  <Border Grid.Row="2" Background="Transparent" Padding="0,10,0,0"><WrapPanel Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox x:Name="AutoToolUpdateCheckBox" VerticalAlignment="Center" Margin="8,0" Checked="AutoToolUpdate_Changed" Unchecked="AutoToolUpdate_Changed"/><CheckBox x:Name="AutoUpdateCheckBox" VerticalAlignment="Center" Margin="8,0" Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"/><Button x:Name="CheckAppUpdateButton" Click="CheckAppUpdate_Click"/><Button x:Name="OpenFolderButton" Click="OpenFolder_Click"/><Button x:Name="UpdateToolsButton" Click="UpdateTools_Click"/><Button x:Name="ClearLogButton" Click="ClearLog_Click"/></WrapPanel></Border>
 </Grid>
</Window>
